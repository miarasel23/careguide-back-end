# Application Environment Configuration
PORT=8000
ENVIRONMENT=development

# MongoDB Connection
# Set your MongoDB URI here. If left empty or connection fails to local mongod, seamless in-memory MongoDB will be used!
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes_db
MONGODB_DB_NAME=secure_notes_db

# JWT Configuration
JWT_SECRET=super_secure_jwt_secret_key_care_guide_interview_2026_note_app
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10800

# CORS
CORS_ORIGIN=*
